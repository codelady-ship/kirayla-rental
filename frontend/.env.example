# Base URL of the Spring Boot API (no trailing slash). Local: http://localhost:8080
# Leave it unset and the site makes no API calls at all: it runs browse-only on the bundled demo snapshot.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public URL of this site, used for canonical/OG/sitemap. Local: http://localhost:3000
# Optional on Vercel (falls back to the project's production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
